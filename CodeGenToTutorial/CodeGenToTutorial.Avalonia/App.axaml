<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:CodeGenToTutorial.Avalonia.Helpers"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="CodeGenToTutorial.Avalonia.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <helpers:DiffLineKindToBackgroundConverter x:Key="DiffLineKindToBackgroundConverter" />
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <helpers:SelectedNavigationItemToHeaderConverter x:Key="SelectedNavigationItemToHeaderConverter" />
    </Application.Resources>

    <Application.Styles>
        <fa:FluentAvaloniaTheme />
    </Application.Styles>
</Application>
