<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:models="using:CodeGenToTutorial.Core.Models"
             xmlns:coreVm="using:CodeGenToTutorial.Core.ViewModels"
             x:Class="CodeGenToTutorial.Avalonia.Views.DiffsDetailControl"
             x:DataType="coreVm:ProposedFileChangeViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding FilePath}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       x:CompileBindings="False" />
            <Button Content="Copy file contents" Click="OnCopyButtonClick" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DiffLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DiffLine">
                        <Grid Margin="4,0" ColumnDefinitions="Auto,*" Background="{Binding Kind, Converter={StaticResource DiffLineKindToBackgroundConverter}}">
                            <TextBlock Grid.Column="0" FontFamily="Cascadia Mono,Consolas,monospace" Text="{Binding Prefix}" />
                            <TextBlock Grid.Column="1"
                                       Margin="4,0,0,0"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       Text="{Binding Text}"
                                       TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
