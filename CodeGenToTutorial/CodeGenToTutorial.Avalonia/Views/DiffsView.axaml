<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:coreVm="using:CodeGenToTutorial.Core.ViewModels"
             xmlns:views="using:CodeGenToTutorial.Avalonia.Views"
             xmlns:vm="using:CodeGenToTutorial.Avalonia.ViewModels"
             x:Class="CodeGenToTutorial.Avalonia.Views.DiffsView"
             x:DataType="vm:DiffsViewModel">

    <Grid ColumnDefinitions="280,*">
        <ListBox Grid.Column="0"
                 Name="FileList"
                 ItemsSource="{Binding Files}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                    <Grid Height="48" ColumnDefinitions="Auto,Auto,*">
                        <CheckBox Grid.Column="0" IsThreeState="True" VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  ToolTip.Tip="Select which of this file's changes to apply." />
                        <ui:SymbolIcon Grid.Column="1" Symbol="Document" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="11" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Padding="16">
            <Grid>
                <TextBlock Text="No proposed changes yet. Run a prompt first, then come back here to review the diff."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="18"
                           IsVisible="{Binding HasNoFiles}" />
                <TextBlock Text="Select a file from the list to view the proposed changes."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="18"
                           IsVisible="{Binding HasFilesButNoneSelected}" />
                <views:DiffsDetailControl DataContext="{Binding Selected}"
                                          IsVisible="{Binding #FileList.SelectedItem, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
