<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:CodeGenToTutorial.Avalonia.ViewModels"
             x:Class="CodeGenToTutorial.Avalonia.Views.PromptView"
             x:DataType="vm:PromptViewModel">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0"
                   Text="Prompt"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Project location" FontSize="12" Opacity="0.7" />
                <TextBox Text="{Binding WorkingDirectoryPath}"
                         Watermark="No folder selected"
                         IsReadOnly="True" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Browse..."
                    Margin="8,20,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding BrowseWorkingDirectoryCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="Prompt text" FontSize="12" Opacity="0.7" />
            <TextBox Name="PromptTextBox"
                     Text="{Binding PromptText}"
                     Watermark="Enter the prompt you want to send to Claude Code..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
            <Button Content="Save prompt" Command="{Binding SavePromptCommand}" />
            <Button Content="Send to Claude Code" Command="{Binding RunPromptCommand}" Classes="accent" />
            <ui:ProgressRing Width="20" Height="20" VerticalAlignment="Center" IsIndeterminate="True" IsActive="{Binding IsRunning}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,4,0,0" Text="{Binding StatusMessage}" />

        <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="Claude Code output" FontWeight="SemiBold" />

        <TextBox Grid.Row="6"
                 Margin="0,4,0,0"
                 Text="{Binding CliOutput}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Cascadia Mono,Consolas,monospace"
                 Height="220"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
