<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:coreVm="using:CodeGenToTutorial.Core.ViewModels"
             xmlns:viewmodels="using:CodeGenToTutorial.Avalonia.ViewModels"
             xmlns:controls="using:CodeGenToTutorial.Avalonia.Controls"
             xmlns:helpers="using:CodeGenToTutorial.Avalonia.Helpers"
             x:Class="CodeGenToTutorial.Avalonia.Views.TutorialDetailControl"
             x:DataType="coreVm:ProposedFileChangeViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding FilePath}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       x:CompileBindings="False" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <Button Name="UndoButton" Content="Undo" Click="OnUndoButtonClick"
                     ToolTip.Tip="Undo the last edit (Ctrl+Z)." />
            <Button Name="RedoButton" Content="Redo" Click="OnRedoButtonClick"
                     ToolTip.Tip="Redo the last undone edit (Ctrl+Y)." />
            <Button Content="Revert to proposed" Command="{Binding RevertToProposedCommand}"
                     ToolTip.Tip="Discard your edits and go back to what Claude proposed." />
            <Button Content="Revert to original" Command="{Binding RevertToOriginalCommand}"
                     ToolTip.Tip="Discard your edits and the proposed change, going back to the file on disk." />
            <TextBlock Text="Edited" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.7" />
        </StackPanel>

        <!-- One editable buffer per file: every step's "Apply this change" writes this file's
             whole content (see FileChangeApplyService), so editing happens here rather than on
             each step's snippet. -->
        <controls:CodeEditor Name="Editor"
                              Grid.Row="2"
                              Margin="0,0,0,8"
                              helpers:TextEditorExtensions.BindableText="{Binding EditedContent, Mode=TwoWay}"
                              FilePath="{Binding FilePath}"
                              IsReadOnly="False"
                              Height="320"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" />

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="StepsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TutorialStepViewModel">
                        <StackPanel Margin="0,0,0,24" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Apply this change" Command="{Binding ApplyCommand}" />
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
