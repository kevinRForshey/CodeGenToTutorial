<UserControl
    x:Class="CodeGenToTutorial.Views.TutorialDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:CodeGenToTutorial.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8">
            <FontIcon
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="&#xE7C3;" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ProposedFileChange.FilePath, Mode=OneWay}"
                Style="{ThemeResource SubtitleTextBlockStyle}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TutorialStepViewModel">
                        <StackPanel Margin="0,0,0,24" Spacing="8">
                            <TextBlock
                                Text="{x:Bind Title}"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind Explanation}"
                                TextWrapping="Wrap" />
                            <TextBox
                                Text="{x:Bind Code}"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Cascadia Mono"
                                MaxHeight="320"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Uid="Tutorial_ApplyButton"
                                    Command="{x:Bind ApplyCommand}" />
                                <TextBlock
                                    Text="{x:Bind StatusMessage, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
