<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             x:Class="Paarde.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16" MaxWidth="720">

            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="14" Background="#4F46E5">
                    <TextBlock Text="P"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Paarde" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Prompt Assist And Review Development Environment" FontSize="13" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       Text="Getting started"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="1." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Open the Prompt tab and click Browse... to choose the project folder you want Claude Code to work in." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="2." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Describe what you want built or changed in the prompt box. Optionally attach context files or folders, pick a preset and tutorial detail level, then click Send to Claude Code." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="3." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Once it finishes, open the Tutorial tab to read the explanation, or the Diffs tab to see the proposed changes file by file." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="4." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap"
                               Text="On the Tutorial tab, select the files or individual hunks you want - editing the proposed content first if you'd like - then click Apply Selected to write them to disk. Undo Last Apply and Revert All Applied are there if you change your mind." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="5." FontWeight="SemiBold" Width="20" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Visit Settings to point the app at your claude CLI executable, customize the prompt template, or switch themes." />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
