<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:Paarde.Avalonia.Helpers"
             xmlns:fa="using:FluentAvalonia.Styling"
             x:Class="Paarde.Avalonia.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Fluent 2 semantic "critical" red, light/dark variants - used by the "danger"
                     button class below (UX pass: distinguish destructive actions like "Revert All
                     Applied" from the page's primary action without inventing a non-standard color). -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="DangerButtonPointerOverBrush" Color="#A4262C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DangerButtonBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="DangerButtonPointerOverBrush" Color="#FFB3BC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <helpers:DiffLineKindToBackgroundConverter x:Key="DiffLineKindToBackgroundConverter" />
            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <helpers:SelectedNavigationItemToHeaderConverter x:Key="SelectedNavigationItemToHeaderConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <fa:FluentAvaloniaTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- UX pass: a "danger" button class for destructive actions (discarding edits/applied
             changes) so they read as distinct from both the default button and the "accent"
             primary-action class FluentAvaloniaTheme already provides. Only Foreground/BorderBrush
             are overridden - Style-level setters win over the ControlTheme's own, the same
             mechanism "accent" relies on - so Background/sizing/padding stay whatever the active
             Fluent theme already uses. -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonPointerOverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonPointerOverBrush}" />
        </Style>
    </Application.Styles>
</Application>
