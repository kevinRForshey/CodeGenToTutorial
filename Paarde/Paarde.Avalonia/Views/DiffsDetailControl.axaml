<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:models="using:Paarde.Core.Models"
             xmlns:coreVm="using:Paarde.Core.ViewModels"
             x:Class="Paarde.Avalonia.Views.DiffsDetailControl"
             x:DataType="coreVm:ProposedFileChangeViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Document" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding FilePath}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       x:CompileBindings="False" />
            <Button Content="Copy file contents" Click="OnCopyButtonClick" />
            <!-- T8.3.1: local view-only state (not persisted, not on the shared Core view model -
                 see DiffsDetailControl.axaml.cs) toggling between the flat inline diff and a
                 side-by-side one. -->
            <ToggleButton Name="SideBySideToggle" Content="Side-by-side" Click="OnViewModeToggled" />
        </StackPanel>

        <!-- T8.3.2: ItemsSource is set from code-behind (RefreshDisplayRows), not bound -
             CollapsibleDiffRow comes from DiffBuilder.BuildCollapsibleRows(DiffLines), which folds
             long runs of unchanged lines into a single clickable placeholder row rather than
             rendering every one. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="DiffLinesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CollapsibleDiffRow">
                        <Grid>
                            <Grid Margin="4,0"
                                  ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding !IsCollapsedPlaceholder}"
                                  Background="{Binding Line.Kind, Converter={StaticResource DiffLineKindToBackgroundConverter}}">
                                <TextBlock Grid.Column="0" FontFamily="Cascadia Mono,Consolas,monospace" Text="{Binding Line.Prefix}" />
                                <TextBlock Grid.Column="1"
                                           Margin="4,0,0,0"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Text="{Binding Line.Text}"
                                           TextWrapping="NoWrap" />
                            </Grid>
                            <Button IsVisible="{Binding IsCollapsedPlaceholder}"
                                    Content="{Binding CollapsedSummary}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnExpandCollapsedRegionClick" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- T8.3.1/T8.3.2: ItemsSource is set from code-behind, not bound - CollapsibleSideBySideDiffRow
             comes from DiffBuilder.BuildCollapsibleSideBySideRows(DiffLines), computed on demand
             rather than kept on the shared ProposedFileChangeViewModel, since the view mode is
             local to this control. -->
        <ScrollViewer Grid.Row="1"
                      Name="SideBySideScrollViewer"
                      IsVisible="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="SideBySideItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CollapsibleSideBySideDiffRow">
                        <Grid>
                            <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding !IsCollapsedPlaceholder}">
                                <Grid Grid.Column="0" Margin="4,0" ColumnDefinitions="Auto,*" Background="{Binding Row.OriginalKind, Converter={StaticResource DiffLineKindToBackgroundConverter}}">
                                    <TextBlock Grid.Column="0" FontFamily="Cascadia Mono,Consolas,monospace" Text="{Binding Row.OriginalPrefix}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="4,0,0,0"
                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                               Text="{Binding Row.OriginalText}"
                                               TextWrapping="NoWrap" />
                                </Grid>
                                <Border Grid.Column="1" Width="1" Margin="8,0" Background="Gray" Opacity="0.3" />
                                <Grid Grid.Column="2" Margin="4,0" ColumnDefinitions="Auto,*" Background="{Binding Row.ProposedKind, Converter={StaticResource DiffLineKindToBackgroundConverter}}">
                                    <TextBlock Grid.Column="0" FontFamily="Cascadia Mono,Consolas,monospace" Text="{Binding Row.ProposedPrefix}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="4,0,0,0"
                                               FontFamily="Cascadia Mono,Consolas,monospace"
                                               Text="{Binding Row.ProposedText}"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </Grid>
                            <Button IsVisible="{Binding IsCollapsedPlaceholder}"
                                    Content="{Binding CollapsedSummary}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnExpandCollapsedRegionClick" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
