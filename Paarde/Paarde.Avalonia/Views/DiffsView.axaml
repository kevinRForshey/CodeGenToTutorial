<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:coreVm="using:Paarde.Core.ViewModels"
             xmlns:views="using:Paarde.Avalonia.Views"
             xmlns:vm="using:Paarde.Avalonia.ViewModels"
             x:Class="Paarde.Avalonia.Views.DiffsView"
             x:DataType="vm:DiffsViewModel">

    <!-- T8.2.3: resizable/persisted pane width - see ResizablePaneHelper, wired up in
         DiffsView.axaml.cs. Dragging FileListSplitter all the way shut collapses the file list. -->
    <Grid Name="WorkspaceGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <!-- T8.4.5: only shown when this page was reached via a tutorial step's "View in Diff"
                 jump (ReturnToStep set) - returns to that step, the reverse of the jump here. -->
            <Button Grid.Row="0" Margin="8,8,8,0" Content="◀ Back to Tutorial" Command="{Binding BackToTutorialCommand}"
                     HorizontalAlignment="Stretch"
                     IsVisible="{Binding ReturnToStep, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

            <ListBox Grid.Row="1"
                     Name="FileList"
                     ItemsSource="{Binding Files}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                        <Grid Height="48" ColumnDefinitions="Auto,Auto,*">
                            <CheckBox Grid.Column="0" IsThreeState="True" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      ToolTip.Tip="Select which of this file's changes to apply." />
                            <ui:SymbolIcon Grid.Column="1" Symbol="Document" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectionSummary}" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Name="FileListSplitter" Width="4" ResizeDirection="Columns" />

        <Border Grid.Column="2" Padding="16">
            <Grid>
                <TextBlock Text="No proposed changes yet. Run a prompt first, then come back here to review the diff."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="18"
                           IsVisible="{Binding HasNoFiles}" />
                <TextBlock Text="Select a file from the list to view the proposed changes."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="18"
                           IsVisible="{Binding HasFilesButNoneSelected}" />
                <ContentControl Content="{Binding Selected}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="coreVm:ProposedFileChangeViewModel">
                            <views:DiffsDetailControl />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
